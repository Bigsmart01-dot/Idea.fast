<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Business Idea Generator</title>
<style>
  body { font-family: Arial, sans-serif; background: #f4f6fb; margin: 0; padding: 0; color: #222; text-align: center; }
  header { background: #3b4cca; color: white; padding: 30px 15px; }
  h1 { margin: 0 0 8px; }
  main { max-width: 600px; margin: 30px auto; padding: 0 15px; }
  #idea { background: white; border-radius: 12px; padding: 30px 20px; font-size: 1.3em; min-height: 80px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
  button { background: #3b4cca; color: white; border: none; border-radius: 8px; padding: 14px 28px; font-size: 1.1em; margin-top: 20px; cursor: pointer; }
  button:hover { background: #2c3aa5; }
  .tools { margin-top: 50px; background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
  .tools a { display: block; margin: 10px 0; color: #3b4cca; font-weight: bold; }
  small { color: #777; }
</style>
</head>
<body>
<header>
  <h1>Business Idea Generator</h1>
  <p>Click the button and get a fresh business idea.</p>
</header>
<main>
  <div id="idea">Your idea will show here.</div>
  <button onclick="newIdea()">Give me an idea</button>

  <div class="tools">
    <h2>Tools to get started</h2>
    <a href="#">Build a store (link coming soon)</a>
    <a href="#">Get web hosting (link coming soon)</a>
    <a href="#">Design your brand (link coming soon)</a>
    <small>Some links may be affiliate links. If you buy through them, I may earn a small commission at no extra cost to you.</small>
  </div>
</main>
<script>
  const ideas = [
    "Start a mobile phone repair and accessories service.",
    "Sell custom printed T-shirts using print-on-demand.",
    "Offer social media management for small local shops.",
    "Run a weekend meal prep and delivery business.",
    "Create an online tutoring service for school subjects.",
    "Start a cleaning service for homes and offices.",
    "Make and sell handmade soap and skincare products.",
    "Build a small blog or YouTube channel around a hobby.",
    "Offer photo and video editing for events and weddings.",
    "Start a dropshipping store for a niche product.",
    "Sell digital templates like CVs, planners, and invoices.",
    "Run a laundry pickup and delivery service."
  ];
  function newIdea() {
    const i = Math.floor(Math.random() * ideas.length);
    document.getElementById("idea").textContent = ideas[i];
  }
</script>
</body>
</html>
